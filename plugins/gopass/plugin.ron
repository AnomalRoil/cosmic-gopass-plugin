(
    name: "Gopass",
    description: "Syntax: gp [-o|-otp] [-n|-name] [:KEY] <words>\nCopy a password, key, OTP or entry name from gopass",
    query: (
        regex: "^gp ",
        help: "gp ",
        isolate: true,
        no_sort: true,
        history: false,
    ),
    bin: (path: "cosmic-gopass-plugin"),
    icon: Name("dialog-password"),
)
